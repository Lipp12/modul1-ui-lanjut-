# ============================================================================
# Konfigurasi Variabel Lingkungan - Modul 6: Integrasi UI dengan Layanan Sistem
# Aplikasi Gatherly (Vue 3 + Vite + MockAPI)
# ============================================================================

# Langkah F - Menyimpan URL Endpoint
# ============================================================================
# 1. Buka https://mockapi.io/ dan login (akun GitHub atau Google).
# 2. Buka project "gatherly-api" yang sudah dibuat (API Prefix: /api/v1).
# 3. Pastikan resource "events" sudah dibuat dan data awal (5 acara) diinput.
# 4. Buka halaman Data / dasbor resource events, salin alamat URL endpoint
#    lengkapnya (contoh: https://mockapi.io/api/v1/.../events).
#    -> Setiap orang memiliki kode endpoint yang berbeda (UNIK).
# 5. Tempelkan alamat tersebut di bawah ini, setelah tanda sama dengan (=).
#    Jangan tambahkan tanda petik atau spasi di akhir baris.
#
# Contoh format (HANYA CONTOH, ganti dengan URL milikmu):
#   VITE_API_URL=https://mockapi.io/api/v1/64a1b2c3d4e5f6/events
# ============================================================================

VITE_API_URL=https://6af28a2342c6561ced3955e7.mockapi.io/:endpoint

# ============================================================================
# Catatan penting:
# - Variabel dengan awalan VITE_ otomatis dikenali oleh Vite.
# - Nilai dapat dibaca di antarmuka browser melalui:
#     import.meta.env.VITE_API_URL
# - Setelah mengubah file .env, matikan server development (Ctrl+C) lalu
#   jalankan ulang dengan `npm run dev` agar perubahan terbaca.
# ============================================================================
